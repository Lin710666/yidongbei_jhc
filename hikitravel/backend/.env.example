# 复制为 .env 后按需修改（本地部署配置）
# ---- AI 本地推理（Ollama）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 需求抽取单独用哪个模型（留空 = 与上面同款）。抽取是"照着说明填空"，
# 对模型能力要求低于规划本身，换个小模型能省掉每次生成开头的一次长调用
OLLAMA_INTENT_MODEL=
# 规划体检单独用哪个模型（留空 = 与上面同款）。体检是"挑毛病"，对模型能力要求
# 低于规划本身，换个小模型（例如 qwen2.5:3b）能明显提速
OLLAMA_CHECK_MODEL=
# 本地 7B 模型在 CPU 上生成一份完整规划需要 1~3 分钟，超时别设太短
OLLAMA_TIMEOUT=180
# 模型常驻时长：一次生成要多次调用大模型，常驻可省掉重复加载（几十秒冷启动）
OLLAMA_KEEP_ALIVE=30m
# 启动预热（1=开，0=关）：服务启动时在后台把模型加载进内存，并把各 Skill 的
# 系统提示词预填进 Ollama 的上下文缓存。缓存按前缀命中，所以预热之后第一次
# 「生成」就能直接进入稳态速度（本机实测：第一次请求约 108s → 约 44s）。
# 预热期间 /api/health 会返回进度，前端会提示「正在预热」。
OLLAMA_PREWARM=1

# ---- 高德开放平台密钥（POI/天气/路线/酒店餐饮，已内置，可直接使用）----
AMAP_API_KEY=e15977855225aaaedebd91c466a3c39e
# 浏览器端交互地图（高德 JS API）单独一套凭据，类型是「Web端(JS API)」，
# 与上面的 Web服务 Key 不通用。同样已内置在 app/config.py 的默认值里，
# 不配 .env 也能出交互地图；缺失时前端自动退回静态地图。
# 安全提醒：JS Key 按设计必然出现在浏览器里，安全密钥同理，藏不住也没必要藏。
# 真正的防滥用手段是在高德控制台给该 Key 配「安全域名白名单」。
AMAP_JS_KEY=2b8f3210dc65ebae33324896c40150cf
AMAP_SECURITY_CODE=20d4d829c08555735655a2c35707a444

# ---- 实时攻略检索（可选，默认关闭）----
# 接公开搜索 API 做"搜索 + 阅读"：把攻略摘要作为**偏好提示**喂给选点提示词。
# 参考的是 DeepSeek 联网搜索那种做法（搜索 + 阅读 + 带引用），
# 用的是搜索引擎的公开结果，不是去爬小红书/抖音（那些要登录、有反爬，也不合规）。
# 三项都配齐才启用；不配就完全跳过，生成流程不受影响。
# 底线：查询里只带目的地城市，不带人数/预算/偏好；摘要只作提示，
#       模型据此挑出来的名字仍要能在高德候选池里找到才算数。
# SEARCH_API_MODE=serper        # serper / bocha（留空 = 关闭）
# SEARCH_API_URL=
# SEARCH_API_KEY=

# ---- 权威名录（国家级 5A 景区）----
# 名单在 app/data/authority.json（当前 256 条，来自维基百科的公开条目，作演示种子）。
# 要换成完整权威名单，把文旅部公告整理成同样格式的 JSON 覆盖它即可。

# ---- 前端静态目录（生产环境由 FastAPI 托管 dist/，本地开发可留空）----
STATIC_DIR=

# ---- 规划体检：带反馈重新生成的最大次数（0 = 只体检不重生成）----
PLAN_MAX_REGENERATE=1

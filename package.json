    "test:audit": "node test/audit.js",
    "test:smoke": "node test/smoke.js",
    "test:providers": "node test/providers.js",
    "test:agent": "node test/agent.js",
    "test:mcp": "node test/mcp-location.js",
    "test:pano": "node test/pano.js",
    "test:i23d": "node test/img23d.js",
    "test:stt": "node test/stt.js",
    "test:avatar": "node test/avatar.js",
    "test:gpu": "node test/gpu.js",
    "test:display": "node test/display.js",
    "test:cdp": "node test/verify-cdp.js",
    "test:blender": "node test/blender.js",
    "mcp:location": "node mcp/location-server.js",
    "blender:start": "node tools/start-blender.js",
